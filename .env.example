# Copiar a .env (que NO se sube a git) para cambiar las credenciales de la base en Docker
DB_USER=postgres
DB_PASSWORD=postgres

# Clave para firmar los JWT (mínimo 32 caracteres). En la nube usar una distinta y secreta.
# Generar una con:  openssl rand -base64 48
JWT_SECRET=dev-only-apunteia-jwt-secret-cambiar-en-produccion-0123456789

# Render + Neon: configurar estas variables en Render, no en el .env local.
# Las siguientes líneas son una plantilla sin credenciales reales.
# SPRING_PROFILES_ACTIVE=render
# DB_URL=
# DB_USER=
# DB_PASSWORD=
# JWT_SECRET=
# JWT_EXPIRATION_MINUTES=120
# DB_URL debe ser JDBC de PostgreSQL para Neon e incluir sslmode=require.
# PORT lo proporciona Render automáticamente; Spring usa 8080 como respaldo.
