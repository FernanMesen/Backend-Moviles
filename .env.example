# Copiar a .env (que NO se sube a git) para cambiar las credenciales de la base en Docker
DB_USER=postgres
DB_PASSWORD=postgres

# Clave para firmar los JWT (mínimo 32 caracteres). En la nube usar una distinta y secreta.
# Generar una con:  openssl rand -base64 48
JWT_SECRET=dev-only-apunteia-jwt-secret-cambiar-en-produccion-0123456789